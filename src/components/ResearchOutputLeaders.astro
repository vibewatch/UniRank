---
import type { ResearchProfiles } from '../data/schema';
import { pageI18n } from '../i18n/page';

interface Props {
  data: ResearchProfiles;
}

const { data } = Astro.props;
const { t, fmt, country } = pageI18n(Astro.url);
const { compact, number } = fmt;
---

<section class="research-leaders surface" aria-label={t('Research output leaderboard', '科研产出排行榜')}>
  <ol class="rl-list">
    {data.leaders.map((leader, index) => (
      <li>
        <span class="rank mono">{String(index + 1).padStart(2, '0')}</span>
        <span class="identity">
          <strong>{leader.name}</strong>
          <span class="meta">{country(leader.country, leader.countryCode)}</span>
        </span>
        <span class="metrics">
          <b class="chip" title={t('OpenAlex h-index across all recorded works', '基于 OpenAlex 全部收录论著的 h 指数')}>
            {t('h-index', 'h 指数')} {number.format(leader.hIndex)}
          </b>
          {leader.lifetimeWorks !== null && (
            <b class="chip" title={t('Lifetime works recorded by OpenAlex', 'OpenAlex 记录的累计论著数')}>
              {t(`${compact.format(leader.lifetimeWorks)} works`, `论著 ${compact.format(leader.lifetimeWorks)}`)}
            </b>
          )}
          {leader.lifetimeCitations !== null && (
            <b class="chip" title={t('Lifetime citations recorded by OpenAlex', 'OpenAlex 记录的累计被引次数')}>
              {t(`${compact.format(leader.lifetimeCitations)} citations`, `被引 ${compact.format(leader.lifetimeCitations)}`)}
            </b>
          )}
        </span>
        <span class="consensus">
          {leader.consensusRank !== null
            ? t(`Consensus #${number.format(leader.consensusRank)}`, `共识第 ${number.format(leader.consensusRank)} 名`)
            : t('Outside consensus top 40', '不在共识前 40 名内')}
        </span>
      </li>
    ))}
  </ol>
  <p class="fine-print">
    {t(
      `Ranked by OpenAlex h-index across ${number.format(data.institutionCount)} institutions with a resolved research-output profile (${data.source}). This is a productivity signal, not a quality ranking—large, long-established research universities accumulate high h-index scores over decades regardless of where they land in any single-year table.`,
      `按 OpenAlex h 指数为 ${number.format(data.institutionCount)} 所已确认科研产出档案的院校排序（${data.source}）。这是产出能力信号，而非质量排名——规模大、历史悠久的研究型大学经过数十年积累，h 指数自然较高，与其在任何单年榜单中的位置无关。`,
    )}
  </p>
</section>

<style>
  .research-leaders {
    padding: clamp(1.25rem, 2.5vw, 2rem);
    display: grid;
    gap: 1.25rem;
  }
  .rl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .rl-list li {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1.4fr) minmax(0, 1.6fr) auto;
    align-items: center;
    gap: 0.6rem 0.9rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-2, transparent);
  }
  .rank {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .identity {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .identity strong {
    font-size: 0.92rem;
  }
  .identity .meta {
    color: var(--muted);
    font-size: 0.74rem;
  }
  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .chip {
    font-weight: 600;
    font-size: 0.68rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    white-space: nowrap;
  }
  .consensus {
    color: var(--muted);
    font-size: 0.76rem;
    text-align: right;
    white-space: nowrap;
  }
  .fine-print {
    margin: 0;
  }
  @media (max-width: 640px) {
    .rl-list li {
      grid-template-columns: 1fr auto;
    }
    .rank {
      display: none;
    }
    .metrics {
      grid-column: 1 / -1;
    }
    .consensus {
      text-align: left;
    }
  }
</style>
