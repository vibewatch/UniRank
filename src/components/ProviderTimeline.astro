---
import type { Provider } from '../data/schema';
import { pageI18n } from '../i18n/page';

interface Props {
  providers: Provider[];
  start?: number;
  end?: number;
}

const {
  providers,
  start = Math.min(...providers.map((provider) => provider.firstYear)),
  end = Math.max(...providers.map((provider) => provider.lastYear)),
} = Astro.props;
const { provider: providerName, kind } = pageI18n(Astro.url);
const span = Math.max(1, end - start);
const pct = (year: number) => (year - start) / span * 100;
// Roughly four intervals, always ending on the final edition year.
const step = Math.max(1, Math.ceil(span / 4));
const ticks: number[] = [];
for (let year = start; year < end; year += step) ticks.push(year);
if (ticks.length > 1 && end - ticks[ticks.length - 1] < step / 2) ticks.pop();
ticks.push(end);
const gridlines = ticks.slice(1, -1);
---

<div class="timeline surface">
  <div class="axis mono" aria-hidden="true">
    <span></span>
    <div class="ticks">
      {ticks.map((year) => <span style={`--left:${pct(year)}%`}>{year}</span>)}
    </div>
  </div>
  {providers.map((provider) => {
    const left = pct(provider.firstYear);
    const width = Math.max(2, (provider.lastYear - provider.firstYear) / span * 100);
    return (
      <div class="timeline-row">
        <div class="provider">
          <i style={`--provider:${provider.color}`}></i>
          <span>
            <strong>{providerName(provider.id, provider.label)}</strong>
            <small>{kind(provider.kind)}</small>
          </span>
        </div>
        <div class="rail">
          {gridlines.map((year) => <i class="gridline" style={`--left:${pct(year)}%`}></i>)}
          <span
            class="range"
            style={`--left:${left}%;--width:${width}%;--provider:${provider.color}`}
            title={`${provider.firstYear}–${provider.lastYear}`}
          ></span>
        </div>
      </div>
    );
  })}
</div>

<style>
  .timeline {
    overflow: hidden;
    padding: 18px 22px 22px;
  }

  .axis,
  .timeline-row {
    display: grid;
    grid-template-columns: 190px minmax(260px, 1fr);
    gap: 18px;
  }

  .axis {
    min-width: 460px;
    margin: 0 0 8px;
    color: #8b9499;
    font-size: 0.58rem;
  }

  .ticks {
    position: relative;
    height: 1.2em;
  }

  .ticks span {
    position: absolute;
    left: var(--left);
    transform: translateX(-50%);
  }

  .ticks span:first-child {
    transform: none;
  }

  .ticks span:last-child {
    transform: translateX(-100%);
  }

  .timeline-row {
    min-width: 460px;
    align-items: center;
    padding: 9px 0;
    border-top: 1px solid #e7e4dd;
  }

  .provider {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 10px;
  }

  .provider i {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--provider);
  }

  .provider span {
    display: grid;
    min-width: 0;
  }

  .provider strong {
    overflow: hidden;
    font-size: 0.76rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .provider small {
    color: var(--muted);
    font-size: 0.6rem;
  }

  .rail {
    position: relative;
    height: 7px;
    border-radius: 999px;
    background: #ece9e2;
  }

  .gridline {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--left);
    width: 1px;
    background: #dcd9d1;
  }

  .range {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--left);
    width: var(--width);
    min-width: 8px;
    border-radius: inherit;
    background: var(--provider);
  }

  @media (max-width: 700px) {
    .timeline {
      overflow-x: auto;
    }
  }
</style>
