---
import type { WebVisibility, WebVisibilityEntry } from '../data/schema';
import { pageI18n } from '../i18n/page';

interface Props {
  data: WebVisibility;
}

const { data } = Astro.props;
const { t, fmt, country } = pageI18n(Astro.url);
const { number } = fmt;

const columns: { key: 'webForward' | 'webQuiet'; eyebrow: string; title: string; blurb: string; entries: WebVisibilityEntry[] }[] = [
  {
    key: 'webForward',
    eyebrow: t('Web-forward', '网络领先'),
    title: t('Louder online than the rankings suggest', '网上声量超出排名所示'),
    blurb: t(
      'Universities whose Webometrics web-presence rank sits far ahead of their academic consensus rank.',
      'Webometrics 网络影响力排名远高于其学术共识排名的大学。',
    ),
    entries: data.webForward,
  },
  {
    key: 'webQuiet',
    eyebrow: t('Web-quiet', '网络低调'),
    title: t('Academic strength the web understates', '学术实力被网络低估'),
    blurb: t(
      'Universities the consensus rates highly but whose public web footprint trails their peers.',
      '学术共识评价很高、但公开网络足迹落后于同侪的大学。',
    ),
    entries: data.webQuiet,
  },
];

const matchPct = data.cohortSize ? Math.round((data.matched / data.cohortSize) * 100) : 0;
const latest = data.latestEdition;
// Prefer the newer edition's head: it is exact even when the edition is capped per country.
const leaders = latest
  ? latest.leaders.slice(0, 8).map((leader) => ({ ...leader, change: leader.previousRank === null ? null : leader.previousRank - leader.rank }))
  : data.leaders.slice(0, 6).map((leader) => ({ ...leader, previousRank: null, change: null }));
---

<section class="web-visibility surface" aria-label={t('Web presence versus academic standing', '网络影响力与学术地位对比')}>
  <header class="wv-head">
    <div>
      <p class="mono">Webometrics {data.year}{latest ? t(` · ${latest.year} leaders`, ` · ${latest.year} 领先者`) : ''}</p>
      <h3>{t('Where web presence and academic standing diverge.', '网络影响力与学术地位的分歧之处。')}</h3>
      <p class="wv-lede">
        {t(
          `Webometrics ranks ${number.format(data.total)} institutions by the size and visibility of their web footprint. Comparing that with the academic consensus across the ${number.format(data.matched)} shared universities (${matchPct}% of the ${number.format(data.cohortSize)}-strong cohort) shows who is over- and under-represented online relative to scholarly standing.`,
          `Webometrics 按网络足迹的规模和可见度为 ${number.format(data.total)} 所院校排名。将其与 ${number.format(data.matched)} 所共同院校（占 ${number.format(data.cohortSize)} 所共识院校的 ${matchPct}%）的学术共识对照，可以看出哪些院校在网上的表现高于或低于其学术地位。`,
        )}
      </p>
    </div>
    <div class="wv-leaders-wrap">
      <p class="mono">{latest ? t(`World top, July ${latest.year}`, `全球前列，${latest.year} 年 7 月`) : t('World top', '全球前列')}</p>
      <ol class="wv-leaders" aria-label={t(`Webometrics ${latest?.year ?? data.year} global leaders`, `Webometrics ${latest?.year ?? data.year} 全球领先者`)}>
        {leaders.map((leader) => (
          <li>
            <span class="rank mono">{String(leader.rank).padStart(2, '0')}</span>
            <span>{leader.name}</span>
            {latest && (
              <span
                class={`move mono ${leader.change === null ? '' : leader.change > 0 ? 'up' : leader.change < 0 ? 'down' : 'flat'}`}
                title={leader.previousRank === null
                  ? t(`Not matched in ${data.year}`, `${data.year} 年未匹配`)
                  : t(`#${leader.previousRank} in ${data.year}`, `${data.year} 年第 ${leader.previousRank} 名`)}
              >
                {leader.change === null ? t('new', '新') : leader.change > 0 ? `▲${leader.change}` : leader.change < 0 ? `▼${-leader.change}` : '='}
              </span>
            )}
          </li>
        ))}
      </ol>
    </div>
  </header>

  <div class="wv-grid">
    {columns.map((column) => (
      <article class="wv-column">
        <header class="wv-col-head">
          <p class="mono">{column.eyebrow}</p>
          <h4>{column.title}</h4>
          <p>{column.blurb}</p>
        </header>
        <ol class="wv-list">
          {column.entries.map((entry) => (
            <li>
              <span class="identity">
                <strong>{entry.name}</strong>
                <span class="meta">{country(entry.country)}</span>
              </span>
              <span class="positions">
                <b class="chip">{t('Web', '网络')} #{number.format(entry.webPos)}</b>
                <b class="chip">{t('Academic', '学术')} #{number.format(entry.academicPos)}</b>
              </span>
              <span
                class={`delta ${entry.webAdvantage >= 0 ? 'up' : 'down'}`}
                title={t('Web position minus academic position within the shared cohort', '共同院校范围内网络名次领先学术名次的位数')}
              >
                {entry.webAdvantage >= 0 ? '+' : ''}{number.format(entry.webAdvantage)}
              </span>
            </li>
          ))}
        </ol>
      </article>
    ))}
  </div>

  <p class="fine-print">
    {t(
      `Positions are ranks within the ${number.format(data.matched)} universities that appear in both Webometrics and the multi-source academic consensus, so the two scales are directly comparable. A positive delta means the web footprint ranks ahead of academic standing; a negative delta means the reverse.`,
      `名次是在同时出现于 Webometrics 和多来源学术共识中的 ${number.format(data.matched)} 所大学范围内计算的，因此两种尺度可以直接比较。正值表示网络足迹的名次领先于学术地位，负值则相反。`,
    )}
    {latest && (
      <>
        {' '}
        {t(
          `The July ${latest.year} edition lists only the top ${latest.perCountry} institutions per country (${number.format(latest.listed)} across ${number.format(latest.countries)} countries), so its world ranks are exact only through #${latest.exactThrough} and the cohort comparison stays on the complete ${data.year} table of ${number.format(data.total)}.`,
          `${latest.year} 年 7 月版只列出每个国家的前 ${latest.perCountry} 所院校（${number.format(latest.countries)} 个国家和地区共 ${number.format(latest.listed)} 所），因此其全球名次仅在第 ${latest.exactThrough} 名以内是确切的；对照分析仍基于 ${data.year} 年完整的 ${number.format(data.total)} 所院校榜单。`,
        )}
      </>
    )}
  </p>
</section>

<style>
  .web-visibility {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: 1.75rem;
  }
  .wv-head {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    align-items: flex-start;
    justify-content: space-between;
  }
  .wv-head .mono {
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
    margin: 0 0 0.4rem;
  }
  .wv-head h3 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    max-width: 26ch;
  }
  .wv-lede {
    margin: 0;
    color: var(--muted);
    max-width: 60ch;
    font-size: 0.92rem;
  }
  .wv-leaders-wrap .mono {
    margin-bottom: 0.6rem;
  }
  .wv-leaders {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    min-width: min(240px, 100%);
  }
  .wv-leaders li {
    display: grid;
    grid-template-columns: 1.75rem 1fr auto;
    gap: 0.6rem;
    align-items: baseline;
    font-size: 0.85rem;
  }
  .wv-leaders .rank {
    color: var(--muted);
    font-size: 0.78rem;
  }
  .wv-leaders .move {
    color: var(--muted);
    font-size: 0.68rem;
    text-align: right;
  }
  .wv-leaders .move.up {
    color: var(--teal-dark);
  }
  .wv-leaders .move.down {
    color: #b64738;
  }
  .wv-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }
  .wv-column {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .wv-col-head p.mono {
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.7rem;
    margin: 0 0 0.35rem;
  }
  .wv-col-head h4 {
    margin: 0 0 0.35rem;
    font-size: 1.02rem;
  }
  .wv-col-head p:not(.mono) {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
    max-width: 40ch;
  }
  .wv-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .wv-list li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 0.6rem 0.9rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-2, transparent);
  }
  .identity {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .identity strong {
    font-size: 0.92rem;
  }
  .identity .meta {
    color: var(--muted);
    font-size: 0.74rem;
  }
  .positions {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    align-items: flex-end;
  }
  .chip {
    font-weight: 600;
    font-size: 0.68rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    white-space: nowrap;
  }
  .delta {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    font-size: 0.95rem;
    min-width: 3.2ch;
    text-align: right;
  }
  .delta.up {
    color: var(--teal-dark);
  }
  .delta.down {
    color: #b64738;
  }
  @media (max-width: 520px) {
    .wv-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .wv-list li {
      grid-template-columns: 1fr auto;
    }
    .positions {
      grid-row: 2;
      grid-column: 1;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
    .delta {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
